generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  engineType      = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Canonical Financial Ledger (single source of truth for finance)
model FinancialLedgerEntry {
  id                   String                    @id @default(cuid())
  businessId           String
  domain               LedgerDomain
  eventType            BillingEventType
  amountCents          Int
  currency             String                    @default("RWF")
  vatAmountCents       Int?
  exVatAmountCents     Int?
  gatewayFeeCents      Int?
  platformFeeCents     Int?
  netAmountCents       Int?
  gateway              PaymentGateway?
  paymentMethod        PaymentMethod?
  status               PaymentTransactionStatus?
  paymentTransactionId String?
  subscriptionId       String?
  marketplaceOrderId   String?
  invoiceNumber        String?
  providerReference    String?
  idempotencyKey       String?                   @unique
  occurredAt           DateTime                  @default(now())
  createdAt            DateTime                  @default(now())

  @@index([businessId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([domain, occurredAt])
  @@index([gateway, occurredAt])
  @@index([paymentTransactionId])
  @@index([subscriptionId])
  @@index([marketplaceOrderId])
  @@index([invoiceNumber])
}

model User {
  id                           String                      @id @default(cuid())
  name                         String
  email                        String                      @unique
  emailVerified                DateTime?
  image                        String?
  password                     String
  phone                        String                      @unique
  roles                        UserRole[]                  @default([OWNER])
  whatsappEnabled              Boolean                     @default(false)
  whatsappNumber               String?
  isActive                     Boolean                     @default(true)
  lastLoginAt                  DateTime?
  supplierId                   String?                     @unique
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt
  affiliateCode                String?                     @unique
  affiliateCookieExpiry        DateTime?
  affiliateEnabled             Boolean                     @default(false)
  businessId                   String?
  referredByAffiliateId        String?
  primaryBranchId              String?
  locale                       String                      @default("en")
  preferredCurrency            String                      @default("RWF")
  timezone                     String                      @default("Africa/Kigali")
  accounts                     Account[]
  affiliate                    Affiliate?                  @relation("AffiliateUser")
  affiliateCommissionsNew      AffiliateCommissionNew[]    @relation("AffiliateCommissions")
  founderPartner               FounderPartner?             @relation("FounderPartnerUser")
  InventoryUpdate              InventoryUpdate[]
  MarketplaceOrder             MarketplaceOrder[]
  ownedBusinesses              Business[]                  @relation("BusinessOwner")
  sales                        Sale[]
  ScanJob                      ScanJob[]
  securityEvents               SecurityEvent[]
  sessions                     Session[]
  staffRolesCreated            StaffRole[]                 @relation("StaffRoleCreatedBy")
  staffTipsReceived            StaffTip[]
  supplierRecommendationLogs   SupplierRecommendationLog[]
  supportConversationsAssigned SupportConversation[]       @relation("SupportConversationsAssignedTo")
  supportConversationsCreated  SupportConversation[]       @relation("SupportConversationsCreatedBy")
  supportMessagesSent          SupportMessage[]            @relation("SupportMessagesSentBy")
  assignedTables               Table[]                     @relation("TableWaiter")
  ticketEvents                 TicketEvent[]
  business                     Business?                   @relation("BusinessUsers", fields: [businessId], references: [id])
  primaryBranch                Branch?                     @relation(fields: [primaryBranchId], references: [id])
  referredByAffiliate          User?                       @relation("AffiliateReferrals", fields: [referredByAffiliateId], references: [id])
  referrals                    User[]                      @relation("AffiliateReferrals")
  supplier                     Supplier?                   @relation("SupplierUser", fields: [supplierId], references: [id])
  devices                      UserDevice[]
  loginOtps                    UserLoginOtp[]
  staffRoleAssignments         UserStaffRole[]
  whatsappMessages             WhatsAppMessage[]
}

model Business {
  id                                String                       @id @default(cuid())
  name                              String
  description                       String?
  address                           String?
  city                              String                       @default("Kigali")
  district                          String?
  country                           String                       @default("RW")
  latitude                          Float?
  longitude                         Float?
  phone                             String
  whatsappNumber                    String?
  ownerId                           String
  planId                            String?
  currency                          String                       @default("RWF")
  timezone                          String                       @default("Africa/Kigali")
  isActive                          Boolean                      @default(true)
  referredByAffiliateId             String?
  whatsappOwnerReportsEnabled       Boolean                      @default(true)
  whatsappClientSlipsEnabled        Boolean                      @default(false)
  whatsappClientSlipsConsent        Boolean                      @default(false)
  whatsappDailyCapClient            Int                          @default(50)
  whatsappMonthlyBudgetCents        Int?
  createdAt                         DateTime                     @default(now())
  updatedAt                         DateTime                     @updatedAt
  businessType                      String?
  cmsNotifyTrending                 Boolean                      @default(false)
  dailyReportEnabled                Boolean                      @default(true)
  dailyReportLocalTime              String                       @default("07:30")
  defaultDepositPercent             Float                        @default(50.0)
  defaultLanguage                   String                       @default("en")
  enableDigitalTipping              Boolean                      @default(false)
  enableQRInVenue                   Boolean                      @default(false)
  enableQRRemote                    Boolean                      @default(false)
  followUpDay10Done                 Boolean                      @default(false)
  followUpDay13Done                 Boolean                      @default(false)
  followUpDay2Done                  Boolean                      @default(false)
  followUpDay5Done                  Boolean                      @default(false)
  freeMonthsGranted                 Int                          @default(0)
  lastDailyReportSentForDate        String?
  maxRemoteOrdersPerSlot            Int                          @default(10)
  nextAction                        String?
  nextActionCompleted               Boolean                      @default(false)
  nextActionDate                    DateTime?
  prepBufferMinutes                 Int                          @default(10)
  requireDepositRemote              Boolean                      @default(true)
  salesNotes                        String?
  salesStatus                       String?                      @default("LEAD")
  slotDurationMinutes               Int                          @default(30)
  splitPaymentConvenienceFeeEnabled Boolean                      @default(false)
  splitPaymentConvenienceFeePercent Float                        @default(1.0)
  taxMode                           TaxMode                      @default(EXCLUSIVE)
  taxRate                           Float                        @default(18.0)
  trialEndDate                      DateTime?
  trialStartDate                    DateTime?
  aiCreditsUsed                     Int                          @default(0)
  aiCreditsLimit                    Int                          @default(20)
  aiResetDate                       DateTime?
  qrCodesCount                      Int                          @default(0)
  cmsPostsThisMonth                 Int                          @default(0)
  storageUsedBytes                  BigInt                       @default(0)
  approvalStatus                    String                       @default("PENDING")
  approvedAt                        DateTime?
  approvedBy                        String?
  duplicateFlags                    Json?
  rejectionReason                   String?
  riskLevel                         String                       @default("LOW")
  inventoryDefaultCostingMethod     String                       @default("WAVG")
  isFoundingMember                  Boolean                      @default(false)
  foundingJoinedAt                  DateTime?
  foundingDiscountPercent           Float                        @default(50.0)
  abTests                           ABTest[]
  aiUsageLogs                       AIUsageLog[]
  acquisitionAttribution            AcquisitionAttribution?
  activityLogs                      ActivityLog[]
  affiliateCommissions              AffiliateCommission[]
  affiliateCommissionsNew           AffiliateCommissionNew[]
  AnomalyAlert                      AnomalyAlert[]
  billingEvents                     BillingEvent[]
  branches                          Branch[]
  featureOverrides                  BusinessFeatureOverride[]
  insightReports                    BusinessInsightReport[]
  receivedInvite                    BusinessInvite?              @relation("InviteInvitee")
  sentInvites                       BusinessInvite[]             @relation("InviteReferrer")
  businessProfile                   BusinessProfile?
  businessReviews                   BusinessReview[]
  businessScans                     BusinessScan[]
  businessViews                     BusinessView[]
  checkoutEvents                    CheckoutEvent[]              @relation("BusinessCheckoutEvents")
  contacts                          Contact[]                    @relation("BusinessContacts")
  contactActivities                 ContactActivity[]            @relation("BusinessContactActivities")
  contactOrganizations              ContactOrganization[]        @relation("BusinessOrganizations")
  contactRelationships              ContactRelationship[]        @relation("BusinessRelationships")
  contactSegments                   ContactSegment[]             @relation("BusinessContactSegments")
  contactTags                       ContactTag[]                 @relation("BusinessContactTags")
  contentPosts                      ContentPost[]
  CostAnomalyAlert                  CostAnomalyAlert[]
  customDomains                     CustomDomain[]
  customers                         Customer[]
  customerReferrals                 CustomerReferral[]
  diningSessionSlips                DiningSessionSlip[]          @relation("BusinessDiningSessionSlips")
  discoverySubscription             DiscoverySubscription?
  goodsReceivedNotes                GoodsReceivedNote[]
  idempotencyKeys                   IdempotencyKey[]
  inventoryConsumption              InventoryConsumption[]
  inventoryItems                    InventoryItem[]
  inventoryUpdates                  InventoryUpdate[]
  inviteCredits                     InviteCredit[]
  loyaltyRules                      LoyaltyRule[]
  marketplaceOrders                 MarketplaceOrder[]
  mediaAssets                       MediaAsset[]
  menuItems                         MenuItem[]
  menuItemCandidates                MenuItemCandidate[]
  menuItemTranslations              MenuItemTranslation[]
  menuSourceDocuments               MenuSourceDocument[]
  optimizationOutcomes              OptimizationOutcome[]
  optimizationRecommendations       OptimizationRecommendation[]
  outlets                           Outlet[]
  paymentTransactions               PaymentTransaction[]
  pointsLedger                      PointsLedger[]
  postAttributions                  PostAttribution[]
  procurementReconciliations        ProcurementReconciliation[]
  promotions                        Promotion[]
  purchaseOrders                    PurchaseOrder[]
  qrCodes                           QrCode[]
  qrDesigns                         QrDesign[]
  recipes                           Recipe[]
  reconciliationLogs                ReconciliationLog[]
  reservations                      Reservation[]
  owner                             User                         @relation("BusinessOwner", fields: [ownerId], references: [id])
  plan                              Plan?                        @relation(fields: [planId], references: [id])
  referredByAffiliate               Affiliate?                   @relation("BusinessAffiliate", fields: [referredByAffiliateId], references: [id])
  rooms                             Room[]
  routeRules                        RouteRule[]
  slaProfiles                       SLAProfile[]
  sales                             Sale[]
  ScanJob                           ScanJob[]
  ScannedDocument                   ScannedDocument[]
  serviceAreas                      ServiceArea[]
  siteBuilderSubscription           SiteBuilderSubscription?
  buyerDocuments                    SmartDiningSlip[]            @relation("BuyerDocuments")
  staffRoles                        StaffRole[]
  staffTips                         StaffTip[]
  stations                          Station[]
  subscriptions                     Subscription[]
  supplierOrders                    SupplierOrder[]
  supplierRecommendationLogs        SupplierRecommendationLog[]
  supportCannedReplies              SupportCannedReply[]         @relation("BusinessSupportCannedReplies")
  supportConversations              SupportConversation[]        @relation("BusinessSupportConversations")
  tables                            Table[]
  tableSessions                     TableSession[]
  taxConfigurations                 TaxConfiguration[]
  users                             User[]                       @relation("BusinessUsers")
  userStaffRoles                    UserStaffRole[]
  waiterCalls                       WaiterCall[]
  whatsappMessages                  WhatsAppMessage[]

  @@map("Restaurant")
}

model Plan {
  id                  String         @id @default(cuid())
  name                String
  code                String         @unique
  description         String?
  priceCents          Int
  annualPriceCents    Int?
  currency            String         @default("RWF")
  features            Json
  maxUsers            Int?
  maxMenuItems        Int?
  whatsappIncluded    Boolean        @default(true)
  supportLevel        String         @default("BASIC")
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  aiCreditsMonthly    Int            @default(50)
  qrCodesLimit        Int?
  cmsPostsLimit       Int?
  storageGBLimit      Int            @default(5)
  siteBuilderIncluded Boolean        @default(false)
  discoveryFeatured   Boolean        @default(false)
  businesses          Business[]
  subscriptions       Subscription[]
}

model MenuItem {
  id              String                @id @default(cuid())
  name            String
  description     String?
  priceCents      Int
  category        String?
  costCents       Int
  isAvailable     Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  allergens       String[]              @default([])
  businessId      String
  dietaryTags     String[]              @default([])
  imageReal       String?
  ingredients     String[]              @default([])
  portionSize     String?               @default("single")
  prepTimeMinutes Int?
  spiceLevel      String?               @default("none")
  recipeId        String?               @unique
  abTests         ABTest[]
  business        Business              @relation(fields: [businessId], references: [id])
  recipe          Recipe?               @relation(fields: [recipeId], references: [id])
  translations    MenuItemTranslation[]
  routeRules      RouteRule[]
  sales           SaleItem[]

  @@index([recipeId])
}

model Sale {
  id                          String                       @id @default(cuid())
  orderNumber                 String                       @unique
  userId                      String
  customerId                  String?
  tableId                     String?
  totalAmountCents            Int
  paymentMethod               PaymentMethod
  paymentStatus               PaymentStatus                @default(PENDING)
  paymentReference            String?
  notes                       String?
  isPaid                      Boolean                      @default(false)
  status                      String                       @default("ACTIVE")
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  businessId                  String
  customerConfirmedAt         DateTime?
  customerName                String?
  customerPhone               String?
  depositCents                Int                          @default(0)
  kitchenReleasedAt           DateTime?
  kitchenStatus               String?                      @default("pending")
  orderSource                 OrderSource                  @default(WAITER_POS)
  outletId                    String?
  paymentTransactionId        String?                      @unique
  prepStartedAt               DateTime?
  readyAt                     DateTime?
  scheduledAt                 DateTime?
  seatId                      String?
  acceptedAt                  DateTime?
  almostReadyAt               DateTime?
  participantId               String?
  preparingAt                 DateTime?
  servedAt                    DateTime?
  tableSessionId              String?
  kitchenDispatchedAt         DateTime?
  kitchenDispatchStatus       String?                      @default("pending")
  kitchenDispatchError        String?
  addedAt                     DateTime?
  expoConfirmedAt             DateTime?
  expoStatus                  ExpoStatus?                  @default(PENDING)
  isAddon                     Boolean                      @default(false)
  parentOrderId               String?
  readyForExpoAt              DateTime?
  servedConfirmedAt           DateTime?
  syncedAt                    DateTime?
  diningSlipItems             DiningSessionSlipItem[]      @relation("SaleDiningSlipItems")
  postAttributions            PostAttribution[]
  business                    Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer                    Customer?                    @relation(fields: [customerId], references: [id])
  outlet                      Outlet?                      @relation(fields: [outletId], references: [id])
  parentOrder                 Sale?                        @relation("OrderAddons", fields: [parentOrderId], references: [id])
  addons                      Sale[]                       @relation("OrderAddons")
  participant                 SessionParticipant?          @relation(fields: [participantId], references: [id])
  paymentTransaction          PaymentTransaction?          @relation(fields: [paymentTransactionId], references: [id])
  seat                        Seat?                        @relation("SeatSales", fields: [seatId], references: [id])
  table                       Table?                       @relation(fields: [tableId], references: [id])
  tableSession                TableSession?                @relation(fields: [tableSessionId], references: [id])
  user                        User                         @relation(fields: [userId], references: [id])
  items                       SaleItem[]
  salePayments                SalePayment[]
  smartDiningSlip             SmartDiningSlip?
  splitPaymentWhatsAppTrigger SplitPaymentWhatsAppTrigger?
  staffTips                   StaffTip[]
  ticketEvents                TicketEvent[]
  tipChoices                  TipChoice[]
  waiterCalls                 WaiterCall[]

  @@index([orderSource])
  @@index([scheduledAt])
  @@index([businessId, orderSource])
  @@index([outletId])
  @@index([seatId])
  @@index([tableSessionId])
  @@index([participantId])
  @@index([kitchenStatus])
  @@index([businessId, kitchenStatus])
  @@index([businessId, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([parentOrderId])
  @@index([isAddon])
  @@index([businessId, isAddon])
  @@index([kitchenDispatchStatus])
  @@index([businessId, kitchenDispatchStatus])
}

model SaleItem {
  id                   String                  @id @default(cuid())
  saleId               String
  menuItemId           String
  quantity             Int
  unitPriceCents       Int
  totalPriceCents      Int
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  instructionTags      String[]                @default([])
  instructions         Json?
  deliveredAt          DateTime?
  itemStatus           ItemStatus?             @default(NEW)
  itemVersion          Int                     @default(1)
  mutationType         MutationType            @default(CREATED)
  parentItemId         String?
  prepStartedAt        DateTime?
  readyAt              DateTime?
  replacedBy           String?
  routedAt             DateTime?
  stationId            String?
  consumptionState     String?                 @default("PENDING")
  diningSlipItems      DiningSessionSlipItem[] @relation("SaleItemDiningSlipItems")
  inventoryConsumption InventoryConsumption[]
  menuItem             MenuItem                @relation(fields: [menuItemId], references: [id])
  sale                 Sale                    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  ticketEvents         TicketEvent[]

  @@index([itemStatus])
  @@index([stationId])
  @@index([saleId, itemStatus])
  @@index([parentItemId])
  @@index([mutationType])
  @@index([consumptionState])
}

model InventoryItem {
  id                   String                 @id @default(cuid())
  name                 String
  description          String?
  category             String?
  unit                 String
  currentStock         Float                  @default(0)
  minStockLevel        Float                  @default(10)
  unitCostCents        Int
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  businessId           String
  costingMethod        String                 @default("WAVG")
  reorderLevel         Float?                 @default(0)
  inventoryConsumption InventoryConsumption[]
  business             Business               @relation(fields: [businessId], references: [id])
  updates              InventoryUpdate[]
  ProductAlias         ProductAlias[]
  recipeIngredients    RecipeIngredient[]
  ScannedDocumentItem  ScannedDocumentItem[]
}

model InventoryUpdate {
  id                   String                @id @default(cuid())
  inventoryItemId      String
  userId               String
  type                 String
  quantity             Float
  reason               String?
  notes                String?
  createdAt            DateTime              @default(now())
  businessId           String
  inventoryConsumption InventoryConsumption?
  business             Business              @relation(fields: [businessId], references: [id])
  inventoryItem        InventoryItem         @relation(fields: [inventoryItemId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id])
}

/// Recipe - defines ingredient composition for a menu item
model Recipe {
  id                   String                 @id @default(cuid())
  businessId           String
  name                 String
  yieldQuantity        Float
  yieldUnit            String
  version              Int                    @default(1)
  isActive             Boolean                @default(true)
  costCentsCached      Int?
  costCalculatedAt     DateTime?
  costStale            Boolean                @default(true)
  notes                String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  inventoryConsumption InventoryConsumption[]
  menuItem             MenuItem?
  business             Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ingredients          RecipeIngredient[]     @relation("RecipeIngredients")
  subRecipeUsages      RecipeIngredient[]     @relation("SubRecipeUsages")

  @@index([businessId, isActive])
  @@index([businessId])
}

/// RecipeIngredient - links recipes to inventory items or sub-recipes
model RecipeIngredient {
  id                   String                 @id @default(cuid())
  recipeId             String
  inventoryItemId      String?
  subRecipeId          String?
  quantity             Float
  unit                 String
  yieldFactor          Float                  @default(1.0)
  isOptional           Boolean                @default(false)
  displayOrder         Int                    @default(0)
  inventoryConsumption InventoryConsumption[]
  inventoryItem        InventoryItem?         @relation(fields: [inventoryItemId], references: [id])
  recipe               Recipe                 @relation("RecipeIngredients", fields: [recipeId], references: [id], onDelete: Cascade)
  subRecipe            Recipe?                @relation("SubRecipeUsages", fields: [subRecipeId], references: [id])

  @@index([recipeId])
  @@index([inventoryItemId])
  @@index([subRecipeId])
}

/// InventoryConsumption - audit trail for inventory deductions from sales
model InventoryConsumption {
  id                         String                @id @default(cuid())
  businessId                 String
  saleItemId                 String
  inventoryItemId            String
  recipeId                   String?
  recipeIngredientId         String?
  quantityConsumed           Float
  unit                       String
  unitCostAtConsumptionCents Int
  totalCostCents             Int
  inventoryUpdateId          String?               @unique
  state                      String                @default("ACTIVE")
  reversedByConsumptionId    String?               @unique
  reasonCode                 String?
  actorUserId                String?
  createdAt                  DateTime              @default(now())
  business                   Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventoryItem              InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  inventoryUpdate            InventoryUpdate?      @relation(fields: [inventoryUpdateId], references: [id])
  recipe                     Recipe?               @relation(fields: [recipeId], references: [id])
  recipeIngredient           RecipeIngredient?     @relation(fields: [recipeIngredientId], references: [id])
  reversedBy                 InventoryConsumption? @relation("ConsumptionReversal", fields: [reversedByConsumptionId], references: [id])
  reversalOf                 InventoryConsumption? @relation("ConsumptionReversal")
  saleItem                   SaleItem              @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([saleItemId])
  @@index([inventoryItemId, createdAt])
  @@index([recipeId])
  @@index([state])
}

model Subscription {
  id                      String                   @id @default(cuid())
  planId                  String
  amountCents             Int
  currency                String                   @default("RWF")
  paymentMethod           PaymentMethod
  paymentReference        String?
  startDate               DateTime
  endDate                 DateTime
  nextBillingDate         DateTime
  isAutoRenew             Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  businessId              String
  status                  SubscriptionStatus       @default(ACTIVE)
  affiliateCommissionsNew AffiliateCommissionNew[]
  billingEvents           BillingEvent[]
  invoices                Invoice[]
  paymentTransactions     PaymentTransaction[]
  business                Business                 @relation(fields: [businessId], references: [id])
  plan                    Plan                     @relation(fields: [planId], references: [id])
}

model Invoice {
  id                   String                @id @default(cuid())
  subscriptionId       String
  invoiceNumber        String                @unique
  amountCents          Int
  currency             String                @default("RWF")
  status               String                @default("PENDING")
  paymentMethod        PaymentMethod?
  paymentReference     String?
  dueDate              DateTime
  paidAt               DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  affiliateCommissions AffiliateCommission[]
  subscription         Subscription          @relation(fields: [subscriptionId], references: [id])
}

model WhatsAppMessage {
  id         String   @id @default(cuid())
  userId     String?
  fromNumber String
  toNumber   String
  message    String
  type       String
  status     String   @default("SENT")
  direction  String
  command    String?
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Supplier {
  id                     String                        @id @default(cuid())
  name                   String
  description            String?
  contactName            String
  email                  String                        @unique
  phone                  String
  whatsappNumber         String?
  address                String?
  city                   String                        @default("Kigali")
  district               String?
  country                String                        @default("RW")
  latitude               Float?
  longitude              Float?
  isVerified             Boolean                       @default(false)
  isActive               Boolean                       @default(true)
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  leadTimeDays           Int                           @default(2)
  minOrderCents          Int?                          @default(0)
  deliveryCoverageCities Json?
  payoutMethod           String?
  payoutDetails          Json?
  AnomalyAlert           AnomalyAlert[]
  CostAnomalyAlert       CostAnomalyAlert[]
  goodsReceivedNotes     GoodsReceivedNote[]
  marketplaceProducts    MarketplaceProduct[]
  purchaseOrders         PurchaseOrder[]
  ScannedDocument        ScannedDocument[]
  documents              SmartDiningSlip[]
  SupplierAlias          SupplierAlias[]
  deliveries             SupplierDelivery[]
  insightsSubscription   SupplierInsightsSubscription?
  orders                 SupplierOrder[]
  payouts                SupplierPayout[]
  performanceCache       SupplierPerformanceCache?
  products               SupplierProduct[]
  recommendationLogs     SupplierRecommendationLog[]
  user                   User?                         @relation("SupplierUser")
}

model SupplierProduct {
  id                  String                @id @default(cuid())
  supplierId          String
  name                String
  description         String?
  category            String?
  unit                String
  unitPriceCents      Int
  minOrderQuantity    Float                 @default(1)
  isAvailable         Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  ProductAlias        ProductAlias[]
  ScannedDocumentItem ScannedDocumentItem[]
  orderItems          SupplierOrderItem[]
