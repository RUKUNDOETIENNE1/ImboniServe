# Multi-stage production worker Dockerfile for Railway
FROM node:20-alpine AS builder

WORKDIR /app

# OpenSSL 3 must be present at prisma generate time so "native" resolves to linux-musl-openssl-3.0.x
RUN apk add --no-cache openssl

# Install deps first (cache layer)
COPY package.json package-lock.json* ./
COPY prisma ./prisma
RUN npm ci --include=dev

# Copy source and tsconfig after deps to avoid busting the dep cache on every code change
COPY tsconfig.json tsconfig.build.json ./
COPY src ./src

# Generate Prisma client then compile TypeScript
RUN npx prisma generate && \
    npm run build:worker

# Production stage
FROM node:20-alpine AS runner

WORKDIR /app

# OpenSSL 3 shared libs required by the Prisma musl engine at runtime
RUN apk add --no-cache openssl

ENV NODE_ENV=production

# Copy only what is needed at runtime
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/prisma ./prisma

# dist/lib/die/orchestrator/worker-start.js  (rootDir=src emits under dist/lib/)
# This starts BOTH extraction and intelligence workers in a single process
CMD ["node", "dist/lib/die/orchestrator/worker-start.js"]
