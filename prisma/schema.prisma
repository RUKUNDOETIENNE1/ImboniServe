// Core ingestion tracker - tracks document upload and processing lifecycle
model ScanJob {
  id              String         @id @default(cuid())
  businessId      String
  createdByUserId String
  documentType    DocumentType
  sourceFileKey   String // Storage key for uploaded file
  sourceMime      String // MIME type (image/jpeg, application/pdf, etc.)
  sourceHash      String // SHA-256 hash for deduplication
  pageCount       Int? // Number of pages (for PDFs)
  provider        String? // OCR provider used (openai, azure, etc.)
  status          DocumentStatus @default(UPLOADED)
  errorMessage    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  business          Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy         User                    @relation(fields: [createdByUserId], references: [id])
  scannedDocument   ScannedDocument?
  processingLogs    DocumentProcessingLog[]
  ExtractionPayload ExtractionPayload?

  @@unique([sourceHash, businessId])
  @@index([businessId, createdAt])
  @@index([status])
  @@index([documentType])
}

// Normalized document container - stores extracted structured data
model ScannedDocument {
  id                         String       @id @default(cuid())
  scanJobId                  String       @unique
  businessId                 String
  documentType               DocumentType
  supplierId                 String?
  matchedPurchaseOrderId     String?
  matchedGoodsReceivedNoteId String?

  // Header fields
  invoiceNumber       String?
  purchaseOrderNumber String?
  deliveryReference   String?
  documentDate        DateTime?

  // Financial fields
  currency      String? @default("RWF")
  subtotalCents Int?
  taxCents      Int?
  totalCents    Int?

  // AI metadata
  providerPayload   Json? // Raw provider response
  normalizedVersion String @default("1.0")
  confidenceOverall Float? // 0.0 - 1.0
  validationScore   Float? // 0.0 - 1.0
  reconciliationStatus String?
  confidenceScore      Float? // 0.0 - 1.0

  // Status
  status DocumentStatus @default(UPLOADED)
  lifecycleState DocumentLifecycleState @default(UPLOADED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scanJob                  ScanJob            @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  business                 Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier                 Supplier?          @relation(fields: [supplierId], references: [id])
  matchedPurchaseOrder     PurchaseOrder?     @relation(fields: [matchedPurchaseOrderId], references: [id])
  matchedGoodsReceivedNote GoodsReceivedNote? @relation(fields: [matchedGoodsReceivedNoteId], references: [id])

  items                        ScannedDocumentItem[]
  reconciliation               ProcurementReconciliation?
  entityLinks                  DocumentEntityLink[]
  anomalyAlerts                AnomalyAlert[]
  eventTimelines               DocumentEventTimeline[]
  ExtractedDocumentHeaderField ExtractedDocumentHeaderField[]

  @@index([invoiceNumber])
  @@index([documentType])
  @@index([matchedPurchaseOrderId])
  @@index([matchedGoodsReceivedNoteId])
  @@index([businessId, status])
  @@index([supplierId])
}

// Line items extracted from documents
model ScannedDocumentItem {
  id                String @id @default(cuid())
  scannedDocumentId String
  lineNo            Int // Line number in document

  // Product fields
  productName       String
  productId         String? // FK to InventoryItem if matched
  supplierProductId String? // FK to SupplierProduct if matched

  // Quantity & pricing
  quantity        Float
  unit            String
  unitPriceCents  Int?
  totalPriceCents Int?

  // Confidence per field (JSON object: { productName: 0.95, quantity: 0.88, ... })
  confidences Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scannedDocument            ScannedDocument              @relation(fields: [scannedDocumentId], references: [id], onDelete: Cascade)
  inventoryItem              InventoryItem?               @relation(fields: [productId], references: [id])
  supplierProduct            SupplierProduct?             @relation(fields: [supplierProductId], references: [id])
  anomalyAlerts              AnomalyAlert[]
  ExtractedDocumentLineField ExtractedDocumentLineField[]

  @@unique([scannedDocumentId, lineNo])
  @@index([scannedDocumentId])
  @@index([productId])
  @@index([supplierProductId])
}

// Debug and observability foundation - processing event log
model DocumentProcessingLog {
  id        String   @id @default(cuid())
  scanJobId String
  stage     String // e.g., "upload", "ocr", "structuring", "validation"
  level     String // "info" | "warn" | "error"
  message   String
  payload   Json? // Additional context
  createdAt DateTime @default(now())

  scanJob ScanJob @relation(fields: [scanJobId], references: [id], onDelete: Cascade)

  @@index([scanJobId, createdAt])
  @@index([level])
}

// Canonical document lifecycle observability timeline
model DocumentEventTimeline {
  id                String   @id @default(cuid())
  scannedDocumentId  String
  stage             String
  status            String
  metadata          Json?
  createdAt         DateTime @default(now())

  scannedDocument ScannedDocument @relation(fields: [scannedDocumentId], references: [id], onDelete: Cascade)

  @@index([scannedDocumentId])
  @@index([stage])
}

// Procurement reconciliation tracker - links documents to operational records
model ProcurementReconciliation {
  id                String @id @default(cuid())
  scannedDocumentId String @unique
  businessId        String

  // Matching fields
  purchaseOrderId      String? @map("matchedPurchaseOrderId")
  goodsReceivedNoteId   String? @map("matchedGoodsReceivedNoteId")
  matchType             String

  // Fingerprint for idempotency (business-scoped unique identifier)
  fingerprint String @unique

  // State
  state ReconciliationState @default(UNMATCHED)

  // Confidence
  confidence Float? // 0.0 - 1.0

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scannedDocument          ScannedDocument    @relation(fields: [scannedDocumentId], references: [id], onDelete: Cascade)
  business                 Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseOrder           PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  goodsReceivedNote       GoodsReceivedNote? @relation(fields: [goodsReceivedNoteId], references: [id])

  @@index([businessId])
  @@index([businessId, matchType])
  @@index([state])
  @@index([purchaseOrderId])
  @@index([goodsReceivedNoteId])
}

// Future intelligence support - flexible entity linking
model DocumentEntityLink {
  id                String         @id @default(cuid())
  scannedDocumentId String
  entityType        EntityLinkType // SUPPLIER | PO | GRN | INVENTORY_ITEM
  entityId          String // ID of the linked entity
  linkType          LinkType // AUTO_MATCH | USER_CONFIRMED | REVIEW_SUGGESTION
  confidence        Float? // 0.0 - 1.0
  createdAt         DateTime       @default(now())

  scannedDocument ScannedDocument @relation(fields: [scannedDocumentId], references: [id], onDelete: Cascade)

  @@unique([scannedDocumentId, entityType, entityId])
  @@index([scannedDocumentId, entityType])
  @@index([entityType, entityId])
}

// Supplier alias mapping for fuzzy matching
model SupplierAlias {
