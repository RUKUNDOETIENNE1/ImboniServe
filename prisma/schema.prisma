  jti       String    @unique
  branchId  String
  tableId   String?
  source    String
  used      Boolean   @default(false)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([jti])
  @@index([expiresAt])
}

model DisposableEmailDomain {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  domain    String   @unique
  createdAt DateTime @default(now())

  @@index([domain])
}

model TrialEligibility {
  id                String    @id @default(dbgenerated("gen_random_uuid()"))
  hashedPhone       String
  hashedEmail       String
  deviceFingerprint String?
  ipRange           String?
  riskScore         Int       @default(0)
  blocked           Boolean   @default(false)
  blockReason       String?
  trialUsedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now())

  @@index([blocked])
  @@index([deviceFingerprint])
  @@index([hashedEmail])
  @@index([hashedPhone])
  @@index([ipRange])
  @@index([riskScore])
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([entityType, entityId])
}

model FeatureFlag {
  id                  String                    @id @default(cuid())
  key                 String                    @unique
  name                String
  description         String?
  enabled             Boolean                   @default(false)
  autoEnableThreshold Int?
  planGated           Boolean                   @default(false)
  minimumPlan         String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  businessOverrides   BusinessFeatureOverride[]

  @@index([key])
}

model BusinessFeatureOverride {
  id            String      @id @default(cuid())
  businessId    String
  featureFlagId String
  enabled       Boolean
  createdAt     DateTime    @default(now())
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@unique([businessId, featureFlagId])
  @@index([businessId])
}

model PlatformMetrics {
  id                  String   @id @default(cuid())
  date                DateTime @unique @default(now())
  activeBusinessCount Int      @default(0)
  totalBusinessCount  Int      @default(0)
  totalSalesCount     Int      @default(0)
  totalRevenueCents   BigInt   @default(0)
  createdAt           DateTime @default(now())

  @@index([date])
}

model Branch {
  id           String        @id @default(cuid())
  businessId   String
  name         String
  address      String?
  phone        String?
  latitude     Float?
  longitude    Float?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  city         String?
  district     String?
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlets      Outlet[]
  rooms        Room[]
  serviceAreas ServiceArea[]
  primaryUsers User[]

  @@unique([businessId, name])
  @@index([businessId, isActive])
}

model Outlet {
  id          String     @id @default(cuid())
  businessId  String
  branchId    String?
  name        String
  type        OutletType @default(RESTAURANT)
  description String?
  address     String?
  city        String?
  district    String?
  latitude    Float?
  longitude   Float?
  phone       String?
  isActive    Boolean    @default(true)
  qrCode      String?    @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  branch      Branch?    @relation(fields: [branchId], references: [id])
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales       Sale[]
  tables      Table[]

  @@unique([businessId, name])
  @@index([businessId, isActive])
  @@index([branchId])
}

// Staff Roles (system and custom) with explicit permissions
model StaffRole {
  id              String   @id @default(cuid())
  businessId      String?
  key             String
  name            String
  description     String?
  color           String?
  icon            String?
  baseRole        UserRole
  isSystem        Boolean  @default(false)
  isActive        Boolean  @default(true)
  permissions     Json
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business      Business?       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByUser User?           @relation("StaffRoleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignments   UserStaffRole[]

  @@unique([businessId, key])
  @@index([businessId, isSystem])
}

// Assignment table linking users to custom/system StaffRole entries for fine-grained permissions
model UserStaffRole {
  id          String   @id @default(cuid())
  userId      String
  staffRoleId String
  businessId  String
  assignedAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     StaffRole @relation(fields: [staffRoleId], references: [id], onDelete: Cascade)
  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, staffRoleId])
  @@index([businessId])
}

model Seat {
  id           String        @id @default(cuid())
  tableId      String
  seatNumber   Int
  seatLabel    String? // "Seat A", "Seat B", "Window Seat 1", etc.
  qrCode       String?       @unique
  qrDesign     Json? // QR design customization (colors, logo, style)
  position     Json? // Placement coordinates {x, y, edge: "left"|"right"|"top"|"bottom"}
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sales        Sale[]        @relation("SeatSales")
  tips         StaffTip[]    @relation("SeatTips")
  table        Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  seatSessions SeatSession[] // Seat selection sessions

  @@unique([tableId, seatNumber])
  @@index([tableId])
  @@index([qrCode])
}

model SeatSession {
  id             String              @id @default(cuid())
  seatId         String
  tableSessionId String?
  participantId  String?             @unique
  state          String              @default("locked") // "locked" | "occupied" | "released"
  lockedAt       DateTime            @default(now())
  lockExpiresAt  DateTime
  lockedByTempId String
  sessionToken   String              @unique
  occupiedAt     DateTime?
  releasedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  seat           Seat                @relation(fields: [seatId], references: [id], onDelete: Cascade)
  tableSession   TableSession?       @relation(fields: [tableSessionId], references: [id])
  participant    SessionParticipant? @relation(fields: [participantId], references: [id])

  @@index([seatId, state])
  @@index([lockExpiresAt])
  @@index([sessionToken])
  @@index([lockedByTempId])
}

model MenuItemTranslation {
  id          String   @id @default(cuid())
  menuItemId  String
  locale      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  businessId  String
