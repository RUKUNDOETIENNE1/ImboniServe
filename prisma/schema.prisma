  checkInDate  DateTime?
  checkOutDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  branch       Branch?   @relation(fields: [branchId], references: [id])
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer? @relation(fields: [customerId], references: [id])

  @@unique([businessId, roomNumber])
  @@index([businessId, status])
  @@index([customerId])
}

model ServiceArea {
  id          String   @id @default(cuid())
  businessId  String
  branchId    String?
  name        String
  description String?
  areaType    String   @default("TABLE")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branch      Branch?  @relation(fields: [branchId], references: [id])
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, isActive])
}

model BusinessProfile {
  id             String           @id @default(cuid())
  businessId     String           @unique
  slug           String           @unique
  tagline        String?
  description    String?
  coverImageUrl  String?
  logoUrl        String?
  cuisineTypes   String[]
  priceRange     String?
  openingHours   Json?
  isPublished    Boolean          @default(false)
  seoTitle       String?
  seoDescription String?
  viewCount      Int              @default(0)
  orderCount     Int              @default(0)
  rating         Float?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviews        BusinessReview[]

  @@index([isPublished])
  @@index([slug])
}

model BusinessReview {
  id          String           @id @default(cuid())
  businessId  String
  customerId  String?
  saleId      String?          @unique
  rating      Int
  comment     String?
  response    String?
  respondedAt DateTime?
  isPublished Boolean          @default(true)
  createdAt   DateTime         @default(now())
  profileId   String?
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  profile     BusinessProfile? @relation(fields: [profileId], references: [id])

  @@index([businessId, isPublished])
}

model BusinessView {
  id         String   @id @default(cuid())
  businessId String
  profileId  String?
  sessionId  String?
  userId     String?
  ipAddress  String?
  userAgent  String?
  referrer   String?
  viewedAt   DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, viewedAt])
  @@index([sessionId])
  @@index([userId])
}

model Promotion {
  id          String                @id @default(cuid())
  businessId  String
  name        String
  description String?
  type        String
  config      Json
  startDate   DateTime
  endDate     DateTime
  daysOfWeek  Int[]
  timeStart   String?
  timeEnd     String?
  isActive    Boolean               @default(true)
  usageLimit  Int?
  usageCount  Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  business    Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  redemptions PromotionRedemption[]

  @@index([businessId, isActive])
  @@index([startDate, endDate])
}

model PromotionRedemption {
  id            String    @id @default(cuid())
  promotionId   String
  saleId        String    @unique
  discountCents Int
  createdAt     DateTime  @default(now())
  promotion     Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
}

model ReconciliationLog {
  id                  String    @id @default(cuid())
  businessId          String
  transactionId       String?
  invoiceNumber       String?
  status              String
  expectedAmountCents Int?
  actualAmountCents   Int?
  discrepancyCents    Int?
  resolvedAt          DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  business            Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([status])
}

/// MPCA-001B: Provider-neutral settlement record — when the provider makes funds available/settled to the merchant
model SettlementRecord {
  id                     String                         @id @default(cuid())
  businessId             String
  provider               PaymentGateway
  providerSettlementId   String?
  internalSettlementId   String                         @unique
  currency               String
  grossAmountCents       Int
  providerFeeCents       Int                            @default(0)
  platformFeeCents       Int                            @default(0)
  otherDeductionsCents   Int                            @default(0)
  netAmountCents         Int
  status                 SettlementStatus
  fundsAvailabilityStatus FundsAvailabilityStatus
  requestedAt            DateTime?
  processingAt           DateTime?
  completedAt            DateTime?
  expectedAvailabilityAt DateTime?
  destinationReference   String?
  providerMetadata       Json?
  reconciliationStatus   SettlementReconciliationStatus @default(RECONCILIATION_PENDING)
  reconciledAt           DateTime?
  reconciliationVarianceCents Int?
  idempotencyKey         String?                        @unique
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  business               Business                       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactionLinks       SettlementTransactionLink[]

  @@index([businessId, createdAt])
  @@index([provider, status])
  @@index([reconciliationStatus])
  @@index([fundsAvailabilityStatus])
}

/// MPCA-001B: Links a SettlementRecord to the PaymentTransactions it covers
model SettlementTransactionLink {
  id                   String           @id @default(cuid())
  settlementRecordId   String
  paymentTransactionId String
  allocatedAmountCents Int
  createdAt            DateTime         @default(now())

  settlementRecord    SettlementRecord   @relation(fields: [settlementRecordId], references: [id], onDelete: Cascade)
  paymentTransaction  PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])

  @@unique([settlementRecordId, paymentTransactionId])
  @@index([settlementRecordId])
  @@index([paymentTransactionId])
}

/// MPCA-001B: Merchant-initiated withdrawal of available funds
model WithdrawalRecord {
  id                    String           @id @default(cuid())
  businessId            String
  provider              PaymentGateway
  providerWithdrawalId  String?
  internalWithdrawalId  String           @unique
  currency              String
  amountCents           Int
  feeCents              Int              @default(0)
  netAmountCents        Int
  status                WithdrawalStatus
  destinationType       String?
  destinationReference  String?
  requestedAt           DateTime         @default(now())
  processingAt          DateTime?
  completedAt           DateTime?
  failedAt              DateTime?
  failureReason         String?
  providerMetadata      Json?
  idempotencyKey        String?          @unique
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  business              Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([provider, status])
}

/// MPCA-001B: Provider capability record — what each provider supports, with verification status
model ProviderCapabilityRecord {
  id                 String                          @id @default(cuid())
  provider           PaymentGateway
  capability         String
  verificationStatus ProviderCapabilityVerification
  evidence           String?
  lastVerifiedAt     DateTime?
  notes              String?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  @@unique([provider, capability])
  @@index([provider])
  @@index([verificationStatus])
}

model WhatsAppTemplate {
  id         String   @id @default(cuid())
  businessId String?
  name       String
  language   String   @default("en")
  category   String
  status     String   @default("PENDING")
  components Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([name, language])
  @@index([status])
}

model TaxConfiguration {
  id          String   @id @default(cuid())
  businessId  String
  taxType     TaxType
  name        String
  rate        Float
  isInclusive Boolean  @default(true)
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, taxType, name])
  @@index([businessId, isActive])
}

model CustomerReferral {
  id            String         @id @default(cuid())
  referrerPhone String
  referrerName  String?
  referralCode  String         @unique
  businessId    String?
  status        ReferralStatus @default(PENDING)
  rewardCents   Int            @default(500000)
  convertedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  business      Business?      @relation(fields: [businessId], references: [id])

  @@index([referralCode])
  @@index([referrerPhone])
  @@index([status])
}

model Reservation {
  id                   String              @id @default(cuid())
  businessId           String
  customerId           String?
  customerName         String
  customerPhone        String
  customerEmail        String?
  reservationDate      DateTime
  reservationTime      String
  reservedAt           DateTime // Actual reservation datetime
  partySize            Int
  tableId              String?
  specialRequests      String?
  status               ReservationStatus   @default(PENDING)
  confirmationCode     String              @unique
  reminderSent         Boolean             @default(false)
  reminderSentAt       DateTime?
  confirmedAt          DateTime?
  completedAt          DateTime?
  forfeitCents         Int                 @default(0)
  noShowReason         String?
  // Feature 3: Deposit-based reservations
  depositCents         Int                 @default(0)
  depositPaidAt        DateTime?
  depositRefundedAt    DateTime?
  depositStatus        String? // PENDING, PAID, REFUNDED, FORFEITED
  paymentTransactionId String?             @unique
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  business             Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer             Customer?           @relation(fields: [customerId], references: [id])
  table                Table?              @relation(fields: [tableId], references: [id])
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])

  @@index([businessId])
  @@index([customerId])
  @@index([reservationDate])
  @@index([status])
  @@index([confirmationCode])
  @@index([depositStatus])
}

model ActivityLog {
  id         String   @id @default(cuid())
  businessId String
  actorId    String?
  action     String
  details    String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

