  createdAt DateTime @default(now())

  // Contact
  emailOrPhone String  @unique
  sourcePage   String? // Where they subscribed from

  // Status
  isActive       Boolean   @default(true)
  unsubscribedAt DateTime?

  // Phase A extensions (CONTENT-002)
  name           String?
  email          String?
  phone          String?
  consentAt      DateTime?
  consentSource  String?
  preferences    Json?
  lastEngagedAt  DateTime?
  bounceCount    Int       @default(0)
