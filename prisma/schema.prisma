// ─── Attribution Models ───────────────────────────────────────────────────

/// Canonical attribution — one per business. Records how a business was acquired.
model AcquisitionAttribution {
  id                String                @id @default(cuid())
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  businessId        String                @unique
  sourceType        AttributionSourceType
  sourceId          String?
  sourceCode        String?
  status            AttributionStatus     @default(CONFIRMED)
  resolvedAt        DateTime              @default(now())

  ipAddress         String?
  userAgent         String?
  utmSource         String?
  utmCampaign       String?
  utmMedium         String?

  trialDaysOverride Int?
  sourceName        String?
  sourceMetadata    Json?

  business          Business              @relation(fields: [businessId], references: [id])

  @@index([sourceType, sourceId])
  @@index([sourceCode])
  @@index([sourceType])
}

// ─── Founder Partner Models ───────────────────────────────────────────────

model FounderPartner {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  userId      String?      @unique
  name        String
  email       String       @unique
  phone       String       @unique

  partnerType PartnerType  @default(FOUNDER)
  status      PartnerStatus @default(PROSPECT)
  onboardedBy String?
  onboardedAt DateTime?

  organization String?
  region       String?
  notes        String?

  user         User?                    @relation("FounderPartnerUser", fields: [userId], references: [id])
  application  FounderPartnerApplication?
  agreement    PartnerAgreement?
  codes        FounderCode[]
  campaigns    PartnerCampaign[]
  commissions  FounderCommission[]
  payouts      FounderPartnerPayout[]
  riskProfile  FounderPartnerRiskProfile?
  activities   PartnerActivity[]
  qbrs         PartnerQBR[]
  auditLogs    PartnershipAuditLog[]

  // Partnership Platform link (PP-001)
  partnershipId String?  @unique
  partnership   Partnership?   @relation("FounderPartnerProfile", fields: [partnershipId], references: [id])

  @@index([status])
  @@index([email])
  @@index([partnerType])
}

model FounderPartnerApplication {
  id          String            @id @default(cuid())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  partnerId   String            @unique

  motivation  String?           @db.Text
  experience  String?
  networkSize String?
  references  Json?

  status      ApplicationStatus @default(SUBMITTED)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNotes String?

  partner     FounderPartner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([status])
}

model PartnerAgreement {
  id          String           @id @default(cuid())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  partnerId   String           @unique

  version     String
  terms       Json?

  signedAt    DateTime?
  effectiveAt DateTime?
  expiresAt   DateTime?

  status      AgreementStatus  @default(PENDING)

  partner     FounderPartner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([status])
}

model FounderCode {
  id              String            @id @default(cuid())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  code            String            @unique
  partnerId       String

  trialDays       Int               @default(30)
  campaignId      String?

  status          FounderCodeStatus @default(ACTIVE)
  expiresAt       DateTime?
  maxRedemptions  Int?
  redemptionCount Int               @default(0)

  label           String?
  notes           String?

  partner         FounderPartner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  campaign        PartnerCampaign?  @relation(fields: [campaignId], references: [id])
  redemptions     FounderCodeRedemption[]

  @@index([partnerId])
  @@index([code])
  @@index([status])
}

model FounderCodeRedemption {
  id               String      @id @default(cuid())
  createdAt        DateTime    @default(now())

  codeId           String
  businessId       String
  userId           String?

  ipAddress        String?
  userAgent        String?

  trialDaysGranted Int

  code             FounderCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@unique([codeId, businessId])
  @@index([codeId])
  @@index([businessId])
}

model PartnerCampaign {
  id                  String         @id @default(cuid())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  partnerId           String
  name                String
  description         String?

  channel             String?
  startDate           DateTime?
  endDate             DateTime?

  targetSignups       Int?
  targetConversions   Int?
  budgetCents         Int?

  status              CampaignStatus @default(DRAFT)

  utmSource           String?
  utmMedium           String?
  utmCampaign         String?

  partner             FounderPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  codes               FounderCode[]

  @@index([partnerId])
  @@index([status])
}

model FounderCommission {
  id           String                  @id @default(cuid())
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  partnerId    String
  businessId   String
  codeId       String?
  invoiceId    String?

  type         FounderCommissionType
  amountCents  Int
  currency     String                  @default("RWF")
  ratePercent  Float

  status       FounderCommissionStatus @default(PENDING)
  lockedUntil  DateTime?
  validatedAt  DateTime?
  paidAt       DateTime?

  periodMonth  Int?
  description  String?

  partner      FounderPartner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, status])
  @@index([businessId])
  @@index([status])
  @@index([createdAt])
}

model FounderPartnerPayout {
  id               String        @id @default(cuid())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  partnerId        String

  amountCents      Int
  currency         String        @default("RWF")
  method           PayoutMethod

  status           PayoutStatus  @default(PENDING)

  approvedBy       String?
  approvedAt       DateTime?
  processedAt      DateTime?
  paidAt           DateTime?
  failedAt         DateTime?
  rejectedAt       DateTime?
  rejectedBy       String?
  rejectReason     String?

  referenceId      String?       @unique
  providerResponse String?

  recipientPhone   String?
  recipientBank    String?
  recipientAccount String?

  partner          FounderPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, status])
  @@index([status])
  @@index([createdAt])
}

model FounderPartnerRiskProfile {
  id              String         @id @default(cuid())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  partnerId       String         @unique
  riskScore       Int            @default(0)
  riskLevel       RiskLevel      @default(LOW)

  flags           String[]

  totalPayouts    Int            @default(0)
  avgPayoutCents  Int            @default(0)
  lastPayoutAt    DateTime?

  partner         FounderPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([riskLevel])
}

model PartnerActivity {
  id          String         @id @default(cuid())
  createdAt   DateTime       @default(now())

  partnerId   String
  type        String
  description String?
  metadata    Json?

  partner     FounderPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@index([type, createdAt])
}

model PartnerQBR {
  id                    String         @id @default(cuid())
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  partnerId             String
  quarter               String

  totalSignups          Int            @default(0)
  totalConversions      Int            @default(0)
  totalRevenueCents     Int            @default(0)
  totalCommissionCents  Int            @default(0)

  highlights            String?        @db.Text
  challenges            String?        @db.Text
  actionItems           String?        @db.Text

  reviewedBy            String?
  reviewedAt            DateTime?
  status                String         @default("DRAFT")

  partner               FounderPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, quarter])
  @@index([partnerId])
}

model PartnershipAuditLog {
  id          String         @id @default(cuid())
  createdAt   DateTime       @default(now())

  partnerId   String
  action      String
  actorId     String?
  oldValue    String?
  newValue    String?
  metadata    Json?

  partner     FounderPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@index([action, createdAt])
}

// ─── Partnership Event Log ────────────────────────────────────────────────

model PartnershipEvent {
  id          String                @id @default(cuid())
  createdAt   DateTime              @default(now())

  type        PartnershipEventType
  entityType  String
  entityId    String

  payload     Json?
  triggeredBy String?
  ipAddress   String?

  @@index([type, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Partnership Platform (PP-001) ────────────────────────────────────────
// Generalized partnership infrastructure supporting all partner types.
// Founder Partner is the first consumer; future partner types reuse
// these models without schema changes.

enum PartnershipLifecycleStatus {
  PROSPECT
  APPLIED
  ONBOARDED
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum PartnershipCodeStatus {
  ACTIVE
  PAUSED
  EXPIRED
  REVOKED
  EXHAUSTED
}

enum PartnershipCommissionType {
  SIGNUP_BONUS
  RECURRING_REVENUE
  CAMPAIGN_BONUS
  TIER_BONUS
  REFERRAL_FEE
  CUSTOM
}

enum PartnershipCommissionStatus {
  PENDING
  VALIDATED
  APPROVED
  PAID
  VOID
  CLAWED_BACK
}

enum PartnershipPayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
  REJECTED
}

enum PartnershipAgreementStatus {
  DRAFT
  SENT
  SIGNED
  ACTIVE
  EXPIRED
  TERMINATED
  AMENDED
}

enum PartnershipCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum AttributionTouchType {
  FIRST_TOUCH
  LAST_TOUCH
  ASSIST
}

enum PartnershipHealthGrade {
  A
  B
  C
  D
  F
}

/// Root entity for all partnerships. Every partner — Founder, Affiliate,
/// Marketer, Tourism Board, etc. — has exactly one Partnership row.
/// Partner-type-specific profiles (e.g. FounderPartner) link back via
/// partnershipId.
model Partnership {
  id              String                     @id @default(cuid())
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  // Identity
  userId          String?                    @unique
  name            String
  email           String
  phone           String?

  // Classification
  partnerType     PartnerType
  status          PartnershipLifecycleStatus @default(PROSPECT)

  // Onboarding
  onboardedBy     String?
  onboardedAt     DateTime?

  // Organization context
  organization    String?
  region          String?
  notes           String?

  // Lifetime metrics (denormalized for dashboards)
  totalSignups        Int                    @default(0)
  totalConversions    Int                    @default(0)
  totalRevenueCents   Int                    @default(0)
  totalCommissionCents Int                   @default(0)
  totalPayoutsCents   Int                    @default(0)

  // Relations
  user                User?                  @relation("PartnershipUser", fields: [userId], references: [id])
  application         PartnershipApplication?
  agreements          PartnershipAgreement[]
  campaigns           PartnershipCampaign[]
  codes               PartnershipCode[]
  commissions         PartnershipCommission[]
  payouts             PartnershipPayout[]
  activities          PartnershipActivityLog[]
  riskProfile         PartnershipRiskProfile?
  healthScore         PartnershipHealthScore?
  auditRecords        PartnershipAuditRecord[]
  attributions        PartnershipAttribution[]

  // Backward-compatible link to FounderPartner profile
  founderPartnerProfile FounderPartner? @relation("FounderPartnerProfile")

  @@index([status])
  @@index([partnerType])
  @@index([email])
}

/// Generalized application flow for any partnership type.
model PartnershipApplication {
  id              String                     @id @default(cuid())
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  partnershipId   String                     @unique

  motivation      String?                    @db.Text
  experience      String?
  networkSize     String?
  references      Json?

  status          ApplicationStatus          @default(SUBMITTED)
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNotes     String?

  partnership     Partnership                @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([status])
}

/// Agreement lifecycle for partnerships. Supports amendment chains
/// via previousAgreementId self-reference.
model PartnershipAgreement {
  id              String                     @id @default(cuid())
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  partnershipId   String

  version         String
  terms           Json?

  signedAt        DateTime?
  effectiveAt     DateTime?
  expiresAt       DateTime?

  status          PartnershipAgreementStatus @default(DRAFT)

  // Amendment chain — self-reference to previous version
  previousAgreementId String?  @unique
  previousAgreement   PartnershipAgreement?   @relation("AgreementAmendmentChain", fields: [previousAgreementId], references: [id])
  amendedBy           PartnershipAgreement?   @relation("AgreementAmendmentChain")

  partnership     Partnership                @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([partnershipId])
  @@index([status])
  @@index([effectiveAt])
  @@index([expiresAt])
}

/// Campaign management for partnerships with denormalized analytics.
model PartnershipCampaign {
  id                  String                     @id @default(cuid())
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  partnershipId       String
  name                String
  description         String?

  channel             String?
  startDate           DateTime?
  endDate             DateTime?

  targetSignups       Int?
  targetConversions   Int?
  budgetCents         Int?

  status              PartnershipCampaignStatus  @default(DRAFT)

  utmSource           String?
  utmMedium           String?
  utmCampaign         String?

  // Analytics denormalized
  actualSignups       Int                        @default(0)
  actualConversions   Int                        @default(0)
  actualRevenueCents  Int                        @default(0)

  partnership         Partnership                @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  codes               PartnershipCode[]
  commissions         PartnershipCommission[]

  @@index([partnershipId])
  @@index([status])
  @@index([channel])
}

/// Generalized code namespace. Any partnership type can issue codes.
/// Replaces FounderCode for new partnerships. FounderCode remains for
/// backward compatibility.
model PartnershipCode {
  id              String                   @id @default(cuid())
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  code            String                   @unique
  partnershipId   String
  campaignId      String?

  trialDays       Int                      @default(0)
  status          PartnershipCodeStatus    @default(ACTIVE)
  expiresAt       DateTime?

  maxRedemptions  Int?
  redemptionCount Int                      @default(0)

  label           String?
  notes           String?

  // Metadata for custom code behavior per partner type
  metadata        Json?

  partnership     Partnership              @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  campaign        PartnershipCampaign?     @relation(fields: [campaignId], references: [id])
  redemptions     PartnershipCodeRedemption[]
  attributions    PartnershipAttribution[]
  commissions     PartnershipCommission[]

  @@index([partnershipId])
  @@index([code])
  @@index([status])
}

/// Tracks each redemption of a partnership code.
model PartnershipCodeRedemption {
  id               String      @id @default(cuid())
  createdAt        DateTime    @default(now())

  codeId           String
  businessId       String
  userId           String?

  ipAddress        String?
  userAgent        String?

  trialDaysGranted Int

  code             PartnershipCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@unique([codeId, businessId])
  @@index([codeId])
  @@index([businessId])
}

/// Multi-touch attribution history. Each business acquisition may have
/// multiple attribution touches (first-touch, last-touch, assists).
/// The canonical attribution remains in AcquisitionAttribution.
model PartnershipAttribution {
  id              String                @id @default(cuid())
  createdAt       DateTime              @default(now())

  partnershipId   String
  businessId      String
  codeId          String?

  sourceType      AttributionSourceType
  touchType       AttributionTouchType
  priority        Int                   @default(0)

  // Attribution metadata
  sourceCode      String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?

  ipAddress       String?
  userAgent       String?

  // Trial context
  trialDaysOverride Int?

  // Whether this touch is the canonical attribution
  isCanonical     Boolean               @default(false)

  partnership     Partnership           @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  code            PartnershipCode?      @relation(fields: [codeId], references: [id])

  @@index([partnershipId])
  @@index([businessId])
  @@index([sourceType])
  @@index([touchType])
  @@index([isCanonical])
}

/// PartnershipAttribution and PartnershipCommission reference businessId
/// as a plain string (no FK to Business) to avoid coupling between the
/// Partnership aggregate and the Business aggregate. This follows the
/// same pattern as MarketerAttribution. BusinessId is a read-only reference.

/// Generalized commission ledger. Any partnership type can accrue commissions.
model PartnershipCommission {
  id              String                       @id @default(cuid())
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  partnershipId   String
  businessId      String
  codeId          String?
  campaignId      String?
  invoiceId       String?

  type            PartnershipCommissionType
  amountCents     Int
  currency        String                       @default("RWF")
  ratePercent     Float

  status          PartnershipCommissionStatus  @default(PENDING)
  lockedUntil     DateTime?
  validatedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  paidAt          DateTime?

  // Payout linkage — set when commission is included in a payout
  payoutId        String?

  periodMonth     Int?
  description     String?

  // Clawback support
  clawbackReason  String?
  clawbackDate    DateTime?

  partnership     Partnership                  @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  code            PartnershipCode?             @relation(fields: [codeId], references: [id])
  campaign        PartnershipCampaign?         @relation(fields: [campaignId], references: [id])
  payout          PartnershipPayout?           @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([partnershipId, status])
  @@index([partnershipId, status, periodMonth])
  @@index([businessId])
  @@index([status])
  @@index([createdAt])
  @@index([type])
  @@index([payoutId])
}

/// Generalized payout. Any partnership type can request payouts.
model PartnershipPayout {
  id               String                     @id @default(cuid())
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  partnershipId    String

  amountCents      Int
  currency         String                     @default("RWF")
  method           PayoutMethod

  status           PartnershipPayoutStatus    @default(PENDING)

  approvedBy       String?
  approvedAt       DateTime?
  processedAt      DateTime?
  paidAt           DateTime?
  failedAt         DateTime?
  rejectedAt       DateTime?
  rejectedBy       String?
  rejectReason     String?

  referenceId      String?                    @unique
  providerResponse String?

  recipientPhone   String?
  recipientBank    String?
  recipientAccount String?

  partnership      Partnership                @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  commissions      PartnershipCommission[]

  @@index([partnershipId, status])
  @@index([status])
  @@index([createdAt])
}

/// Generalized activity log. Replaces PartnerActivity for new partnerships.
model PartnershipActivityLog {
  id              String         @id @default(cuid())
  createdAt       DateTime       @default(now())

  partnershipId   String
  type            String
  description     String?
  metadata        Json?

  partnership     Partnership    @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([partnershipId, createdAt])
  @@index([type, createdAt])
}

/// Risk profile for partnerships. Tracks fraud signals and payout risk.
model PartnershipRiskProfile {
  id              String         @id @default(cuid())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  partnershipId   String         @unique
  riskScore       Int            @default(0)
  riskLevel       RiskLevel      @default(LOW)

  flags           String[]

  totalPayouts    Int            @default(0)
  avgPayoutCents  Int            @default(0)
  lastPayoutAt    DateTime?

  partnership     Partnership    @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([riskLevel])
}

/// Health score for partnerships. Computed from signups, conversions,
/// revenue, activity, and risk signals. Updated periodically.
model PartnershipHealthScore {
  id              String                 @id @default(cuid())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  partnershipId   String                 @unique

  score           Int                    @default(0)
  grade           PartnershipHealthGrade @default(C)

  // Component scores (0-100 each)
  acquisitionScore    Int                @default(0)
  conversionScore     Int                @default(0)
  revenueScore        Int                @default(0)
  engagementScore     Int                @default(0)
  riskComponentScore  Int                @default(0)

  // Trend
  previousScore   Int?
  trendDirection  String?

  // Metadata
  computedAt      DateTime               @default(now())
  notes           String?

  partnership     Partnership            @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([grade])
  @@index([score])
}

/// Audit record for partnerships. Tracks data-level changes (who changed
/// what field from what value to what value). Distinct from
/// PartnershipActivityLog which tracks business-level timeline events.
model PartnershipAuditRecord {
  id              String         @id @default(cuid())
  createdAt       DateTime       @default(now())

  partnershipId   String
  action          String
  actorId         String?
  oldValue        String?
  newValue        String?
  metadata        Json?

  partnership     Partnership    @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([partnershipId, createdAt])
  @@index([action, createdAt])
}

// ============================================================
// EDITORIAL CONTENT MODELS (Phase A — CONTENT-002)
// Platform-level editorial system — separate from business CMS
// ============================================================

model EditorialArticle {
  id            String   @id @default(cuid())
  type          String
  title         String
  subtitle      String?
  slug          String   @unique
  excerpt       String?
  body          String
  bodyFormat    String   @default("MARKDOWN")
  status        String   @default("DRAFT")
  authorId      String?
  reviewerId    String?
  publisherId   String?
  publishedAt   DateTime?
  scheduledAt   DateTime?
  archivedAt    DateTime?
  coverImageId  String?
  topicId       String?
  tags          String[]
  seoMeta       Json?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author        User?              @relation("AuthoredArticles", fields: [authorId], references: [id])
  reviewer      User?              @relation("ReviewedArticles", fields: [reviewerId], references: [id])
  publisher     User?              @relation("PublishedArticles", fields: [publisherId], references: [id])
  topic         Topic?             @relation(fields: [topicId], references: [id])
  transitions   ContentTransition[]
  articleTags   ArticleTag[]
  productLinks  ArticleProductLink[]

  @@index([status, publishedAt])
  @@index([type, status])
  @@index([topicId, status])
  @@index([publishedAt])
}

model Topic {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  color       String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      Topic?   @relation("TopicHierarchy", fields: [parentId], references: [id])
  children    Topic[]  @relation("TopicHierarchy")
  articles    EditorialArticle[]

  @@index([parentId, sortOrder])
}

model Tag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  articleTags ArticleTag[]
}

model ArticleTag {
  id        String   @id @default(cuid())
  articleId String
  tagId     String
  createdAt DateTime @default(now())

  article   EditorialArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag              @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([articleId, tagId])
  @@index([tagId])
}

model ContentTransition {
  id         String   @id @default(cuid())
  articleId  String
  fromStatus String
  toStatus   String
  actorId    String
  note       String?
  createdAt  DateTime @default(now())

  article    EditorialArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@index([toStatus, createdAt])
}

model PlatformMediaAsset {
  id            String   @id @default(cuid())
  type          String
  storageKey    String
  filename      String
  altText       String?
  caption       String?
  attribution   String?
  width         Int?
  height        Int?
  durationSec   Int?
  thumbnailKey  String?
  sizeBytes     Int
  mimeType      String
  tags          String[]
  usageCount    Int      @default(0)
  uploadedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type, createdAt])
}

model ArticleProductLink {
  id           String   @id @default(cuid())
  articleId    String
  productKey   String
  productLabel String?
  linkType     String   @default("MENTIONED")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  article      EditorialArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, productKey])
  @@index([productKey])
}

model ContentEvent {
  id          String   @id @default(cuid())
  articleId   String?
  eventType   String
  metadata    Json?
  sessionId   String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  refCode     String?
  createdAt   DateTime @default(now())

  @@index([articleId, eventType, createdAt])
  @@index([eventType, createdAt])
  @@index([sessionId, createdAt])
}
