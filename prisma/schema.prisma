// ====================================================
// OPERATIONAL COORDINATION MODELS (Phase 1)
// ====================================================

// Station - Operational destination for order items
model Station {
  id           String      @id @default(cuid())
  businessId   String
  name         String // Display name: "Kitchen", "Bar", "Grill", "Pastry"
  code         String // Unique code: "KITCHEN", "BAR", "GRILL", "PASTRY"
  type         StationType @default(KITCHEN)
  isActive     Boolean     @default(true)
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  routeRules   RouteRule[]
  slaProfiles  SLAProfile[]
  ticketEvents TicketEvent[]

  @@unique([businessId, code])
  @@index([businessId, isActive])
  @@index([businessId, type])
}

// RouteRule - Maps menu items/categories to stations
model RouteRule {
  id         String @id @default(cuid())
  businessId String
  stationId  String

  // Routing criteria (one must be set)
  menuItemId String? // Item-specific override
  category   String? // Category-level routing

  priority  Int      @default(0) // Higher priority wins
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  station  Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([businessId, isActive])
  @@index([menuItemId])
  @@index([category])
  @@index([stationId])
}

// TicketEvent - Append-only operational event log
model TicketEvent {
  id         String  @id @default(cuid())
  saleId     String
  saleItemId String? // Optional: item-level events
  stationId  String? // Optional: station context

  eventType TicketEventType
  actorId   String? // User who triggered event
  actorName String? // Cached actor name

  // Event metadata
  previousState String?
  newState      String?
  metadata      Json? // Flexible payload for event-specific data

  // Phase 3: Deduplication and ordering
  idempotencyKey String? // Unique key to prevent duplicate events
  sequenceNumber Int? // Ordering within saleItem

  createdAt DateTime @default(now())

  sale     Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleItem SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  station  Station?  @relation(fields: [stationId], references: [id], onDelete: SetNull)
  actor    User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([saleItemId, idempotencyKey])
  @@index([saleId, createdAt])
  @@index([saleItemId, sequenceNumber])
  @@index([eventType])
  @@index([createdAt])
  @@index([stationId])
  @@index([idempotencyKey])
}

// SLAProfile - Configurable timing thresholds
model SLAProfile {
  id         String  @id @default(cuid())
  businessId String
  stationId  String? // Station-specific, or null for default
  category   String? // Category-specific, or null for default

  warningAfterMinutes Int @default(8)
  breachAfterMinutes  Int @default(15)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  station  Station? @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([businessId, isActive])
  @@index([stationId])
  @@index([category])
}

// ServicePromise - Promise Engine tracking entity
model ServicePromise {
  id          String       @id @default(cuid())
  businessId  String
  saleId      String
  promiseType String       @default("ORDER_PREPARATION")
  state       PromiseState @default(ON_TRACK)

  // Timing context
  startedAt        DateTime  // When the promise clock started (dispatch or prep start)
  expectedAt       DateTime  // When the promise should be fulfilled
  warningAt        DateTime  // When warning threshold is reached
  criticalAt       DateTime  // When critical threshold is reached

  // State transitions
  warningTriggeredAt  DateTime?
  criticalTriggeredAt DateTime?
  fulfilledAt         DateTime?
  failedAt            DateTime?
  recoveredAt         DateTime?

  // Evaluation context
  warningAfterMinutes Int
  breachAfterMinutes  Int
  actualMinutes       Int?

  // Idempotency: one active promise per sale+type
  idempotencyKey String @unique

  // Metadata
  lastEvaluatedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([businessId, state])
  @@index([saleId])
  @@index([businessId, saleId])
  @@index([state, expectedAt])
}

enum PromiseState {
  ON_TRACK
  WARNING
  CRITICAL
  FULFILLED
  FAILED
  RECOVERED
}

