}

model MenuItemCandidate {
  id               String             @id @default(cuid())
  sourceDocumentId String
  businessId       String
  name             String
  description      String?
  category         String?
  priceCents       Int?
  confidence       Float              @default(0.0)
  rawData          Json?
  status           String             @default("PENDING")
  reviewedBy       String?
