  @@unique([supplierProductId, normalized])
  @@index([normalized])
}

// Anomaly detection and alerts (placeholder for future intelligence)
model AnomalyAlert {
  id                    String  @id @default(cuid())
  businessId            String
  supplierId            String?
  scannedDocumentId     String?
  scannedDocumentItemId String?

  // Alert metadata
  type     String // e.g., "PRICE_SPIKE", "DUPLICATE_INVOICE", "QUANTITY_ANOMALY"
  severity AnomalySeverity
  title    String
  details    Json? // Additional context
  confidence Float? // 0.0 - 1.0

