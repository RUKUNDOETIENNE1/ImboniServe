  payerName            String?
  payerPhone           String?
  payerEmail           String?
  amountCents          Int
  itemIds              String[] // Array of SaleItem IDs assigned to this payer
  status               SalePaymentStatus @default(PENDING)
  paymentTransactionId String?           @unique
  paidAt               DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

